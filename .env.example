# 키 이름만 적습니다. 실제 값은 .env.local(로컬) 또는 Vercel 환경변수에만 넣으세요.

# Supabase 프로젝트 설정 > API (또는 Connect)에서 확인
NEXT_PUBLIC_SUPABASE_URL=
# 새 키 형식(sb_publishable_...) 권장. 예전 anon 키를 쓰는 경우 아래 ANON_KEY에 넣어도 됩니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 매직링크가 돌아올 사이트 주소 (로컬: http://localhost:3000, 배포: https://도메인)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 단계 8(AI API 직접 연동)에서만 사용 — 지금은 비워 둡니다.
# AI_DIRECT_ENABLED=false
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
